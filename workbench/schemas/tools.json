          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "case_list",
      "description": "列出本地案例。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "case_get",
      "description": "读取案例状态、全部消息、来源元数据及历次状态。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          }
        },
        "required": [
          "case_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "message_append",
      "description": "追加原始用户或 Agent 消息。消息不能被修改，Agent 消息不能作业务证据。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "role",
          "text"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "source_add",
      "description": "保存一个明确指定的本地文件或文本；二进制仅保存原件并标记待解析。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "derived_from": {
            "type": "string"
          }
        },
        "required": [
          "case_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "source_get",
      "description": "读取本案例来源的完整文本、原件位置和来源链。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "source_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "state_update",
      "description": "乐观锁更新案例状态；旧对象ID、text及引用不可删除或改写。修订时新增ID并将旧项标为superseded，保留旧证据与反证。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "object"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "expected_revision",
          "state"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "context_assemble",
      "description": "按字符预算组合完整状态、方法、消息和来源；逐项列出遗漏，不静默裁剪。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "budget_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 200000
          },
          "method_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "library_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "case_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "case_export",
      "description": "导出完整 JSON 或 Markdown 内容；不自动写入任意路径。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ]
          }
        },
        "required": [
          "case_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "source_promote",
      "description": "明确授权一个来源作为长期资料；不自动使其成为其他案例的事实。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "source_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "library_search",
      "description": "仅检索已主动加入长期资料的文本；跨案例引用需另行核验。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ]
}
